{
  "manifest_version": 3,
  "name": "Sci-Synth",
  "version": "1.0.0",
  "description": "Open a PDF in Sci-Synth and hold Alt over a word, equation, figure or scanned text to get an explanation from your own AI provider.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open in Sci-Synth",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab"],
  "optional_permissions": ["webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
