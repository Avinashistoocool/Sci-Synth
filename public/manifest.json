{
  "manifest_version": 3,
  "name": "PDF AI Explorer",
  "version": "0.5.1",
  "description": "Hold Alt and hover over any word, sentence, equation, figure or scanned text in a PDF to get an instant AI explanation.",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open PDF AI Explorer" },
  "options_page": "options.html",
  "permissions": ["storage", "unlimitedStorage", "webRequest", "tabs", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}




